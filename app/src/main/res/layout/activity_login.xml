<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/marble"
    tools:context=".LoginActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="414dp"
        android:layout_height="300dp"
        app:srcCompat="@drawable/black_squiggle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="60dp"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/gradient_curved_bg.png"
        android:layout_width="492dp"
        android:layout_height="669dp"
        android:layout_marginTop="240dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.777"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/gradient_curved_bg" />

    <TextView
        android:id="@+id/Logintxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:text="Login"
        android:textColor="@android:color/white"
        android:textSize="60sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="60dp"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/LoginNameBtn"
        android:layout_width="190dp"
        android:layout_height="50dp"
        android:layout_marginTop="340dp"
        android:text="Name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="250dp"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/PasswordBtn"
        android:layout_width="189dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="Password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="300dp"
        app:layout_constraintTop_toBottomOf="@id/LoginNameBtn" />

    <Button
        android:id="@+id/ForgotPasswordBtn"
        android:layout_width="189dp"
        android:layout_height="48dp"
        android:layout_marginTop="90dp"
        android:text="Forgot Password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="300dp"
        app:layout_constraintTop_toBottomOf="@id/PasswordBtn" />

    <Button
        android:id="@+id/RegisterBtn"
        android:layout_width="189dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="Register me"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="300dp"
        app:layout_constraintTop_toBottomOf="@id/ForgotPasswordBtn" />

    <TextView
        android:id="@+id/LoginWelcometxt"
        android:layout_width="101dp"
        android:layout_height="54dp"
        android:text="SIGN IN TO CONTINUE"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        tools:layout_editor_absoluteX="155dp"
        tools:layout_editor_absoluteY="267dp" />

    <TextView
        android:id="@+id/LoginNametxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textColor="@android:color/white"
        tools:layout_editor_absoluteX="81dp"
        tools:layout_editor_absoluteY="321dp" />

    <TextView
        android:id="@+id/Passwordtxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:textColor="@android:color/white"
        tools:layout_editor_absoluteX="81dp"
        tools:layout_editor_absoluteY="390dp" />

    <TextView
        android:id="@+id/ResetPrompttxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESET HERE"
        android:textColor="@android:color/white"
        tools:layout_editor_absoluteX="165dp"
        tools:layout_editor_absoluteY="596dp" />

    <TextView
        android:id="@+id/RegisterPrompttxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REGISTER HERE"
        android:textColor="@android:color/white"
        tools:layout_editor_absoluteX="154dp"
        tools:layout_editor_absoluteY="664dp" />


</androidx.constraintlayout.widget.ConstraintLayout>