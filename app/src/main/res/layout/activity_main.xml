<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/marble">
    <!--    Group-->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="411dp"
        android:layout_height="269dp"
        android:layout_marginTop="184dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:rotation="45"
        app:layout_constraintTop_margin="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_square_24_black" />

    <ImageView
        android:id="@+id/budget_beaters.pngimg"
        android:layout_width="413dp"
        android:layout_height="278dp"
        android:layout_marginTop="176dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/budget_beaters" />
    <!-- group end -->
<!--    Group-->
    <ImageView
        android:id="@+id/swipeBack.pngimg"
        android:layout_width="359dp"
        android:layout_height="180dp"
        android:layout_marginTop="432dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_crop_7_5_24" />
    <ImageView
        android:id="@+id/swipe.pngimg"
        android:layout_width="122dp"
        android:layout_height="53dp"
        android:layout_marginTop="495dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_margin="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/swipey" />

    <!-- group end -->
    <!--    Group-->
      <TextView
          android:id="@+id/Swipe1txt"
          android:layout_width="336dp"
          android:layout_height="141dp"
          android:layout_marginTop="572dp"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:text="Swipe to enter"
          android:textColor="@android:color/black"
          android:textSize="48sp"
          android:textStyle="bold"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_margin="60dp"
          app:layout_constraintTop_toTopOf="parent" />

      <TextView
          android:id="@+id/Swipe2txt"
          android:layout_width="333dp"
          android:layout_height="130dp"
          android:layout_marginTop="572dp"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:text="Swipe to enter"
          android:textColor="@android:color/white"
          android:textSize="48sp"
          android:textStyle="bold"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_margin="60dp"
          app:layout_constraintTop_toTopOf="parent" />
    <!-- group end -->

  </androidx.constraintlayout.widget.ConstraintLayout>