<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/marble">

    <ImageView
        android:id="@+id/Logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <ImageView
        android:id="@+id/swipeBack"
        android:layout_width="359dp"
        android:layout_height="180dp"
        android:layout_marginTop="432dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_crop_7_5_24" />
    <ImageView
        android:id="@+id/swipe.pngimg"
        android:layout_width="122dp"
        android:layout_height="53dp"
        android:layout_marginTop="495dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/swipey" />

      <TextView
          android:id="@+id/Swipe1txt"
          android:layout_width="336dp"
          android:layout_height="141dp"
          android:layout_marginTop="572dp"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:text="SWIPE TO ENTER"
          android:textColor="@android:color/black"
          android:textSize="48sp"
          android:textStyle="bold"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

      <TextView
          android:id="@+id/Swipe2txt"
          android:layout_width="333dp"
          android:layout_height="130dp"
          android:layout_marginTop="572dp"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:text="SWIPE TO ENTER"
          android:textColor="@android:color/white"
          android:textSize="48sp"
          android:textStyle="bold"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>