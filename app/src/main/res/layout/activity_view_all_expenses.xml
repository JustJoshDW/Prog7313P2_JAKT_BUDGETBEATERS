<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ViewAllExpensesActivity"
    android:background="@drawable/marble">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="420dp"
        android:layout_height="241dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/black_squiggle" />

    <TextView
        android:id="@+id/ViewAllExpensestxt"
        android:text="VIEW ALL EXPENSES"
        android:layout_width="273dp"
        android:layout_height="161dp"
        android:layout_marginTop="40dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/gradient_curved_bg.png"
        android:layout_width="492dp"
        android:layout_height="669dp"
        android:layout_marginTop="168dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.654"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/gradient_curved_bg" />

    <TextView
        android:id="@+id/CHOOSEDATEtxt"
        android:layout_width="331dp"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:text="PLEASE CHOOSE ONE OF THE BELOW:"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/gradient_curved_bg.png" />

    <ImageView
        android:id="@+id/lineview3"
        android:layout_width="410dp"
        android:layout_height="10dp"
        android:layout_marginTop="264dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/white_line" />

    <Button
        android:id="@+id/AddExpenseBtn"
        android:layout_width="244dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/white_button_border"
        android:text="ADD EXPENSE"
        android:textColor="#FF00CC"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.514"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lineview3" />

    <Button
        android:id="@+id/RemoveExpenseBtn"
        android:layout_width="249dp"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/white_button_border"
        android:text="REMOVE EXPENSES"
        android:textColor="#FF00CC"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.53"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/AddExpenseBtn" />

    <Button
        android:id="@+id/ViewExpenseBtn"
        android:layout_width="249dp"
        android:layout_height="48dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/white_button_border"
        android:text="VIEW EXPENSES"
        android:textColor="#FF00CC"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.53"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/RemoveExpenseBtn" />

    <Button
        android:id="@+id/CatIncomeBtn"
        android:layout_width="249dp"
        android:layout_height="75dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/white_button_border"
        android:text="VIEW INCOME BY CATEGORIES"
        android:textColor="#FF00CC"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.53"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ViewExpenseBtn" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</androidx.constraintlayout.widget.ConstraintLayout>